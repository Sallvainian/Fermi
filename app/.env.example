# Environment the test suites read. Nothing here is required: every value has
# a local default, and none is a secret (test.yml reads no secret, AD-23).
# Export a value in your shell to override it; no tool loads this file.

# Playwright Utils' auth-session environment name (folder under app/.auth/).
TEST_ENV=local

# Where Playwright opens the app. playwright.config.ts builds the shell and
# serves it here with `vite preview`.
BASE_URL=http://localhost:4173

# The local Supabase stack. Read from `supabase status` when unset; CI sets
# them from .github/actions/setup-supabase. Test helpers refuse any URL whose
# host is not 127.0.0.1 or localhost.
SUPABASE_URL=http://127.0.0.1:56321
# SUPABASE_PUBLISHABLE_KEY=   (from `supabase status`: PUBLISHABLE_KEY)
# SUPABASE_SERVICE_ROLE_KEY=  (from `supabase status`: SERVICE_ROLE_KEY)
